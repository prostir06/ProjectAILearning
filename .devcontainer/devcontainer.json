{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libgomp1; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo 'Packages installed'",
  "postAttachCommand": {
    "server": "python run.py"
  },
  "portsAttributes": {
    "5000": {
      "label": "Flask Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    5000
  ],
  "containerEnv": {
    "HOST": "0.0.0.0",
    "PORT": "5000",
    "FLASK_DEBUG": "0"
  }
}
